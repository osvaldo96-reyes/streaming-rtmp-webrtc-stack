# IP con la que los navegadores alcanzan este servidor (candidato ICE de WebRTC).
# localhost funciona solo en esta máquina; para la red usa la IP LAN, p. ej. 192.168.1.50
HOST_IP=127.0.0.1

# Streams que el relay reenvía de SRS a OvenMediaEngine (separados por coma)
STREAMS=demo,sala1,sala2

# Puerto del reproductor web
PLAYER_PORT=8088
